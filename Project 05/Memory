/**
 * The complete address space of the Hack computer's memory,
 * including RAM and memory-mapped I/O. 
 * The chip facilitates read and write operations, as follows:
 *     Read:  out(t) = Memory[address(t)](t)
 *     Write: if load(t-1) then Memory[address(t-1)](t) = in(t-1)
 * In words: the chip always outputs the value stored at the memory 
 * location specified by address. If load=1, the in value is loaded 
 * into the memory location specified by address. This value becomes 
 * available through the out output from the next time step onward.
 * Address space rules:
 * Only the upper 16K+8K+1 words of the Memory chip are used. 
 * Access to address>0x6000 is invalid and reads 0. Access to any address
 * in the range 0x4000-0x5FFF results in accessing the screen memory 
 * map. Access to address 0x6000 results in accessing the keyboard 
 * memory map. The behavior in these addresses is described in the Screen
 * and Keyboard chip specifications given in the lectures and the book.
 */
CHIP Memory {
    IN in[16], load, address[15];
    OUT out[16];

    PARTS:
    // Step 1: Decode RAM and I/O selection
    DMux(in=load, sel=address[14], a=ramLoad, b=ioLoad);

    // Step 2: Decode Screen and Keyboard selection
    DMux(in=ioLoad, sel=address[13], a=screenLoad, b=keyboardLoad);

    // Step 3: RAM16K
    RAM16K(in=in, load=ramLoad, address=address[0..13], out=ramOut);

    // Step 4: Screen memory
    Screen(in=in, load=screenLoad, address=address[0..12], out=screenOut);

    // Step 5: Check whether address is exactly 0x6000
    Or(a=address[0], b=address[1], out=o1);
    Or(a=o1, b=address[2], out=o2);
    Or(a=o2, b=address[3], out=o3);
    Or(a=o3, b=address[4], out=o4);
    Or(a=o4, b=address[5], out=o5);
    Or(a=o5, b=address[6], out=o6);
    Or(a=o6, b=address[7], out=o7);
    Or(a=o7, b=address[8], out=o8);
    Or(a=o8, b=address[9], out=o9);
    Or(a=o9, b=address[10], out=o10);
    Or(a=o10, b=address[11], out=o11);
    Or(a=o11, b=address[12], out=lowerBits);
    Not(in=lowerBits, out=keyboardSelect);

    // Step 6: Keyboard memory
    Keyboard(out=keyboardOut);

    // Only allow keyboard output at address 0x6000
    Mux16(a=false, b=keyboardOut, sel=keyboardSelect, out=keyboardMasked);

    // Step 7: Select Screen or Keyboard
    Mux16(a=screenOut, b=keyboardMasked, sel=address[13], out=ioOut);

    // Step 8: Select RAM or I/O
    Mux16(a=ramOut, b=ioOut, sel=address[14], out=out);
}