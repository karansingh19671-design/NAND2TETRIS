/**
 * A 16-bit counter.
 * if      reset(t): out(t+1) = 0
 * else if load(t):  out(t+1) = in(t)
 * else if inc(t):   out(t+1) = out(t) + 1
 * else              out(t+1) = out(t)
 */
CHIP PC {
    IN in[16], reset, load, inc;
    OUT out[16];

    PARTS:
    // Store current value
    Register(in=nextValue, load=true, out=current);

    // Increment current value
    Inc16(in=current, out=incremented);

    // Select incremented value or current value
    Mux16(a=current, b=incremented, sel=inc, out=incResult);

    // Select input or previous result
    Mux16(a=incResult, b=in, sel=load, out=loadResult);

    // Reset has highest priority
    Mux16(a=loadResult, b=false, sel=reset, out=nextValue);

    // Send current value to output
    Or16(a=current, b=false, out=out);
}